# Email Notification System Configuration
# Copy this file to .env and fill in your actual values

# Email Service Configuration
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Email Notifications - Global Settings
# Set to 'false' to disable all email notifications
EMAIL_NOTIFICATIONS_ENABLED=true

# Individual Notification Types
# Set to 'false' to disable specific notification types
CAMPAIGN_CREATION_NOTIFICATIONS=true
BILLBOARD_APPROVAL_NOTIFICATIONS=true
BILLBOARD_REJECTION_NOTIFICATIONS=true
PUBLISHER_ACCOUNT_NOTIFICATIONS=true
BILLBOARD_VERIFICATION_NOTIFICATIONS=true

# Company and Support Information
SUPPORT_EMAIL=support@billboardhub.com
ADMIN_PANEL_URL=https://admin.billboardhub.com

# PostgreSQL Database Configuration
PGHOST=adscape-server.postgres.database.azure.com
PGUSER=adscapedatabase
PGPORT=5432
PGDATABASE=postgres
PGPASSWORD={your-password}

# Database Configuration
# DATABASE_URL will be automatically constructed from the PostgreSQL variables above
# You can also override it directly if needed:
# DATABASE_URL="postgresql://username:password@localhost:5432/billboard_hub"

# Prisma pool sizing
# For the long-running server process, raise these to support higher concurrency.
# Keep them lower on serverless platforms unless you use a DB proxy / PgBouncer.
DB_CONNECTION_LIMIT=100
DB_POOL_TIMEOUT=60
DB_CONNECT_TIMEOUT=20

# JWT Secret (existing)
JWT_SECRET=your-jwt-secret-here

# Browser Push Notifications (admin) - optional; auto-generated if not set
# Generate with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=your-public-key
# VAPID_PRIVATE_KEY=your-private-key

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Other existing configurations...
