generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int       @id @default(autoincrement())
  email              String    @unique @db.VarChar(255)
  password           String?   @db.VarChar(255)
  fullName           String?   @map("full_name")
  phoneNumber        String?   @map("phone_number") @db.VarChar(20)
  companyName        String?   @map("company_name")
  registrationNumber String?   @map("registration_number")
  address            String?
  gstDocumentUrl     String?   @map("gst_document_url")
  panDocumentUrl     String?   @map("pan_document_url")
  totalbookings      Int?
  lastbooking        DateTime? @db.Date
  totalspent         String?   @db.VarChar(20)
  status             String?   @db.VarChar(20)
  joindate           DateTime? @db.Date
  googleId           String?   @map("google_id") @db.VarChar(255)
  emailVerified      Boolean?  @map("email_verified") @default(false)

  @@map("users")
}

/// The underlying table does not contain a valid unique identifier and can therefore currently not be handled by Prisma Client.
model AdminUser {
  id       Int     @default(autoincrement())
  email    String? @db.VarChar
  password String? @db.VarChar

  @@map("admin_user")
  @@ignore
}

model Publisher {
  id              Int              @id @default(autoincrement())
  name            String
  email           String           @unique
  phone           String
  location        String?
  totalBillboards Int?             @map("total_billboards")
  revenue         String?
  status          String?
  joinDate        DateTime?        @map("join_date") @db.Date
  password        String           @default("") @db.VarChar(255)
  role            String?
  address         String?
  businessInfo    Json?            @map("business_info")
  businessType    String?          @map("business_type")
  city            String?
  companyName     String?          @map("company_name")
  pincode         String?
  state           String?
  website         String?
  googleId        String?          @map("google_id") @db.VarChar(255)
  permissions     Json?            @map("permissions")
  metric          PublisherMetric?

  @@map("publishers")
}

model Billboard {
  id                   String    @id @default(dbgenerated("nextval('billboards_id_seq'::regclass)"))
  location             String?
  city                 String?
  state                String?
  type                 String?
  orientation          String?
  dailyViewership      Int?      @map("daily_viewership")
  pricePerDay          Int?      @map("price_per_day")
  available            Boolean?  @default(true)
  size_width           Int?
  size_height          Int?
  size_unit            String?
  size_category        String?
  images               String[]
  width                Int?
  height               Int?
  unit                 String?
  category             String?
  latitude             Float?
  longitude            Float?
  userId               String?   @map("user_id")
  adDuration           String?   @map("ad_duration")
  openingTime          String?   @map("opening_time")
  closingTime          String?   @map("closing_time")
  maxAdvertisers       Int?      @map("max_advertiser_per_day")
  description          String?
  resolution           String?   @db.VarChar(50)
  name                 String?   @default("NULL")
  autoBrightness       Boolean   @default(false) @map("auto_brightness")
  boardFormat          String?   @map("board_format") @db.VarChar(50)
  audioOutput          Boolean   @default(false) @map("audio_output")
  video                String?   @db.VarChar(500)
  reason               String[]
  status               String?   @default("pending")
  screen_id            String?
  createdAt            DateTime? @default(now()) @map("created_at")
  rejectionReason      String?   @map("rejection_reason")
  updatedAt            DateTime? @updatedAt @map("updated_at")
  maxAdvertiseDuration Int?      @map("max_advertise_duration")
  max_slots_per_day    Int?      @default(8)
  slot_duration        Int?      @default(60)
  slot_start_time      String?   @default("09:00")
  slot_end_time        String?   @default("18:00")
  slotAvailability     Json?     @map("slot_availability") // Stores 2 months of slot data: { "DD.MM.YYYY": available_slots }

  // Signage player defaults (configured by superadmin)
  defaultAssetUrl      String?   @map("default_asset_url") @db.VarChar(500)
  defaultAssetType     String?   @map("default_asset_type") @db.VarChar(20)
  defaultAssetDuration Int?      @map("default_asset_duration") // seconds

  // Bulk booking discount
  bulkDiscountEnabled       Boolean   @default(false) @map("bulk_discount_enabled")
  bulkDiscountPercent       Int?      @map("bulk_discount_percent")
  bulkDiscountThresholdDays Int?      @map("bulk_discount_threshold_days")

  // Optional slot 10 (enabled by superadmin; asset uploaded by billboard owner)
  slot10Enabled        Boolean   @default(false) @map("slot10_enabled")
  slot10AssetUrl       String?   @map("slot10_asset_url") @db.VarChar(500)
  slot10AssetType      String?   @map("slot10_asset_type") @db.VarChar(20)
  slot10AssetDuration  Int?      @map("slot10_asset_duration") // seconds

  @@map("billboards")
}

model Campaign {
  id           String    @id @default(dbgenerated("nextval('campaigns_id_seq'::regclass)"))
  userName     String    @map("user_name")
  campaignName String?   @map("campaign_name")
  status       String?
  totalAmount  Decimal?  @map("total_amount") @db.Decimal
  startDate    DateTime? @map("start_date") @db.Date
  endDate      DateTime? @map("end_date") @db.Date
  billboards   Json?
  assets       Json?
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner        String?
  approvedByEmail String? @map("approved_by_email") @db.VarChar(255)
  approvedByRole  String? @map("approved_by_role") @db.VarChar(50)

  @@map("campaigns")
}

model GeneratedSlot {
  id           String    @id @default(cuid())
  campaignId   String    @map("campaign_id")
  billboardIds String[]  @map("billboard_ids")
  screenId     String[]  @map("screen_id")
  createdDate  DateTime? @default(now()) @map("created_date") @db.Timestamp(6)
  updatedDate  DateTime? @default(now()) @updatedAt @map("updated_date") @db.Timestamp(6)
  slots        Json

  @@unique([campaignId], map: "generated_slots_campaign_id_key")
  @@map("generated_slots")
}

model AssetPlayLog {
  id         Int      @id @default(autoincrement())
  screenId   String   @map("screen_id")
  assetUrl   String   @map("asset_url")
  playedAt   DateTime @default(now()) @map("played_at") @db.Timestamp(6)
  campaignId String?  @map("campaign_id")
  durationMs Int?     @map("duration_ms")
  success    Boolean? @default(true)

  @@index([campaignId], map: "idx_asset_play_logs_campaign")
  @@map("asset_play_logs")
}

model AssetPlay {
  id         Int      @id @default(autoincrement())
  screenId   String   @map("screen_id")
  assetUrl   String   @map("asset_url")
  playDate   DateTime @map("play_date") @db.Date
  playCount  Int?     @default(0) @map("play_count")
  campaignId String?  @map("campaign_id")

  @@unique([screenId, assetUrl, playDate])
  @@unique([screenId, assetUrl, playDate], map: "asset_plays_unique_slot_per_day")
  @@unique([screenId, assetUrl, campaignId, playDate], map: "unique_asset_play")
  @@index([campaignId], map: "idx_asset_plays_campaign")
  @@map("asset_plays")
}

model playlists {
  id     Int      @id @default(autoincrement())
  name   String   @db.VarChar
  assets String[]
}

model signage_assets {
  id         Int      @id @default(autoincrement())
  image_url  String
  duration   Int
  start_time DateTime @db.Timestamp(6)
  end_time   DateTime @db.Timestamp(6)
  screen_id  String
}

model slots {
  id           String    @id @db.Uuid
  billboard_id String
  asset_url    String
  start_date   DateTime  @db.Timestamp(6)
  end_date     DateTime  @db.Timestamp(6)
  duration     Int?
  updated_at   DateTime? @default(now()) @db.Timestamp(6)
}

model Registration {
  id              Int      @id @default(autoincrement())
  personalInfo    Json     @map("personal_info")
  businessInfo    Json     @map("business_info")
  documents       Json
  status          String   @default("pending")
  rejectionReason String?  @map("rejection_reason")
  submittedAt     DateTime @default(now()) @map("submitted_at") @db.Timestamp(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(6)
  password        String?  @db.VarChar(255)
  googleId        String?  @map("google_id") @db.VarChar(255)
  googlePicture   String?  @map("google_picture")

  @@map("registrations")
}

model PublisherMetric {
  id              Int       @id @default(autoincrement())
  publisherId     Int       @unique
  totalBillboards Int       @default(0)
  totalBookings   Int       @default(0)
  totalRevenue    Float     @default(0)
  joinDate        DateTime
  lastBooking     DateTime?
  status          String?   @db.VarChar(20)
  settings        Json?
  publisher       Publisher @relation(fields: [publisherId], references: [id])

  @@map("publisher_metrics")
}

model SuperAdminEmail {
  id                Int       @id @default(autoincrement())
  email             String    @unique @db.VarChar(255)
  name              String?   @db.VarChar(255)
  isActive          Boolean?  @default(true) @map("is_active")
  notificationTypes String[]  @map("notification_types")
  createdAt         DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isActive], map: "idx_superadmin_emails_active")
  @@index([email], map: "idx_superadmin_emails_email")
  @@map("superadmin_emails")
}

model EmailNotification {
  id               Int       @id @default(autoincrement())
  notificationType String    @map("notification_type") @db.VarChar(100)
  recipientEmail   String    @map("recipient_email") @db.VarChar(255)
  subject          String    @db.VarChar(500)
  status           String    @default("pending") @db.VarChar(50)
  messageId        String?   @map("message_id") @db.VarChar(255)
  errorMessage     String?   @map("error_message")
  data             Json?
  sentAt           DateTime? @map("sent_at") @db.Timestamptz(6)
  createdAt        DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime? @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([createdAt], map: "idx_email_notifications_created_at")
  @@index([recipientEmail], map: "idx_email_notifications_recipient")
  @@index([status], map: "idx_email_notifications_status")
  @@index([notificationType], map: "idx_email_notifications_type")
  @@map("email_notifications")
}

model PlayerScreen {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  machineId  String    @unique
  screenId   String    @unique
  resolution String?
  os         String?
  appVersion String?
  ipAddress  String?
  createdAt  DateTime  @default(now()) @db.Timestamp(6)
  updatedAt  DateTime  @default(now()) @updatedAt @db.Timestamp(6)
  lastActive DateTime? @default(now()) @db.Timestamptz(6)
  statinfo   String?   @default("active")
  updated_at DateTime? @default(now()) @db.Timestamptz(6)
}

model BillboardAvailability {
  id           Int      @id @default(autoincrement())
  billboardId  String   @map("billboard_id")
  date         DateTime @db.Date
  availability Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([billboardId, date], map: "billboard_availability_uniq")
  @@map("billboard_availability")
}

model DefaultAsset {
  id        Int       @id @default(autoincrement())
  assetUrl  String
  assetName String?
  assetType String?   @default("image")
  duration  Int?      @default(10)
  isActive  Boolean?  @default(true)
  createdAt DateTime? @default(now()) @db.Timestamptz(6)
  updatedAt DateTime? @default(now()) @db.Timestamptz(6)
}

model billboard_bookings {
  id           String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  billboard_id String
  campaign_id  String
  start_date   DateTime  @db.Date
  end_date     DateTime  @db.Date
  total_slots  Int
  status       String?   @default("ACTIVE")
  created_at   DateTime? @default(now()) @db.Timestamp(6)
  updated_at   DateTime? @default(now()) @db.Timestamp(6)

  @@unique([billboard_id, campaign_id, start_date, end_date])
  @@index([billboard_id], map: "idx_billboard_bookings_billboard")
  @@index([campaign_id], map: "idx_billboard_bookings_campaign")
  @@index([start_date, end_date], map: "idx_billboard_bookings_dates")
  @@index([status], map: "idx_billboard_bookings_status")
}

model notifications {
  id              Int       @id @default(autoincrement())
  recipient_email String?   @db.VarChar(255)
  recipient_role  String?   @db.VarChar(50)
  type            String    @db.VarChar(100)
  title           String    @db.VarChar(300)
  message         String?
  entity_type     String?   @db.VarChar(50)
  entity_id       String?   @db.VarChar(100)
  is_read         Boolean?  @default(false)
  created_at      DateTime? @default(now()) @db.Timestamptz(6)

  @@index([created_at], map: "idx_notifications_created_at")
  @@index([is_read], map: "idx_notifications_is_read")
  @@index([recipient_email, recipient_role], map: "idx_notifications_recipient")
}

model slot_availability {
  id              String    @id @default(dbgenerated("(gen_random_uuid())::text"))
  billboard_id    String
  date            DateTime  @db.Date
  total_slots     Int?      @default(8)
  booked_slots    Int?      @default(0)
  available_slots Int?      @default(8)
  last_updated    DateTime? @default(now()) @db.Timestamp(6)

  @@unique([billboard_id, date])
  @@index([billboard_id], map: "idx_slot_availability_billboard")
  @@index([date], map: "idx_slot_availability_date")
}





model AdscapePlayer {
  id             String   @id @db.Uuid @default(uuid())
  screenId       String   @unique @db.VarChar(64)
  connectionCode String?  @db.VarChar(20)
  appVersion     String   @db.VarChar(10) // F1, F2, F3
  flowType       String?  @db.VarChar(10) // F1, F2, or null for normal player
  deviceName     String?  @db.VarChar(255)
  screenWidth    Int?
  screenHeight   Int?
  ipAddress      String?  @db.VarChar(45)
  location       String?  @db.VarChar(255)
  osVersion      String?  @db.VarChar(50)
  appVersionCode String?  @db.VarChar(20)
  lastSeen       DateTime @default(now())
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PushSubscription { 
  id          Int      @id @default(autoincrement()) 
  endpoint    String   @unique 
  keys        Json 
  adminEmail  String? 
  createdAt   DateTime @default(now()) 
}

model PlayerAsset {
  id         String    @id @default(uuid()) @db.Uuid
  url        String    @unique
  checksum   String?
  sizeBytes  BigInt?   @map("size_bytes")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("player_assets")
}

model DailySchedule {
  id           String      @id @default(uuid()) @db.Uuid
  screenId     String      @map("screen_id")
  scheduleDate DateTime    @map("schedule_date") @db.Date
  generatedAt  DateTime?   @default(now()) @map("generated_at") @db.Timestamptz(6)
  slots        DailySlot[]

  @@unique([screenId, scheduleDate])
  @@map("daily_schedules")
}

model DailySlot {
  id           String        @id @default(uuid()) @db.Uuid
  scheduleId   String        @map("schedule_id") @db.Uuid
  schedule     DailySchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  slotNumber   Int           @map("slot_number") // 1 to 8
  campaignId   String?       @map("campaign_id") // Optional
  assetUrl     String        @map("asset_url")
  durationSec  Int           @map("duration_sec")
  slotStart    DateTime      @map("slot_start") @db.Timestamptz(6)
  slotEnd      DateTime      @map("slot_end") @db.Timestamptz(6)

  @@index([scheduleId, slotNumber])
  @@map("daily_slots")
}

model ScreenUsage {
  id           Int      @id @default(autoincrement())
  screenId     String   @map("screen_id")
  sessionStart DateTime @map("session_start") @db.Timestamptz(6)
  sessionEnd   DateTime? @map("session_end") @db.Timestamptz(6)
  durationSec  Int      @default(0) @map("duration_sec")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([screenId])
  @@map("screen_usage_logs")
}

model PlaybackStat {
  id           Int      @id @default(autoincrement())
  screenId     String   @map("screen_id")
  assetId      String   @map("asset_id")
  playCount    Int      @default(0) @map("play_count")
  totalDuration Int     @default(0) @map("total_duration_sec")
  lastPlayedAt DateTime @map("last_played_at") @db.Timestamptz(6)
  syncDate     DateTime @default(now()) @map("sync_date") @db.Timestamptz(6)

  @@index([screenId, assetId])
  @@map("playback_stats_logs")
}

// Stores raw playback analytics sync batches coming from offline-first players.
// This is intentionally append-only for audit/debugging.
model PlaybackAnalytics {
  id        String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  deviceId  String   @map("device_id")
  screenId  String   @map("screen_id")
  sentAt    DateTime? @map("sent_at") @db.Timestamptz(6)
  receivedAt DateTime @default(now()) @map("received_at") @db.Timestamptz(6)
  rowCount  Int      @default(0) @map("row_count")
  payload   Json?    // full request body, including rows

  @@index([screenId], map: "idx_playback_analytics_screen")
  @@index([receivedAt], map: "idx_playback_analytics_received_at")
  @@map("playback_analytics")
}

// Developer-facing error log storage for rendering server errors in the admin panel.
model ErrorLog {
  id         Int       @id @default(autoincrement())
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  level      String    @default("error") @db.VarChar(10)
  message    String
  stack      String?
  method     String?   @db.VarChar(10)
  path       String?
  statusCode Int?      @map("status_code")
  userId     String?   @map("user_id")
  userEmail  String?   @map("user_email")
  meta       Json?

  @@index([createdAt], map: "idx_error_logs_created_at")
  @@map("error_logs")
}
